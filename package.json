{
  "name": "ephemera",
  "version": "1.0.0",
  "description": "Temporary browser document rooms and isolated Swarm research tools",
  "private": true,
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "ingest": "tsx src/ingestion.ts",
    "keygen": "tsx src/crypto/keygen.ts",
    "mock-bee": "tsx src/dev-mock/mock-bee.ts",
    "test:crypto": "tsx test/crypto.test.ts",
    "test:dead-drop": "tsx test/dead-drop.test.ts",
    "test:ai": "tsx test/ai-engine.test.ts",
    "compile": "tsx src/chainlink/compiler.ts",
    "test:contract": "tsx test/smart-contract-tee.test.ts",
    "ui": "npm --prefix frontend run dev",
    "ui:build": "npm --prefix frontend run build",
    "deploy:sepolia": "tsx scripts/deploy-sepolia.ts",
    "vercel-build": "npm --prefix frontend install && npm --prefix frontend run build",
    "test": "node --import tsx --test test/security/*.test.ts",
    "test:http": "node --test test/security/http.test.mjs",
    "test:legacy": "npm run test:crypto && npm run test:dead-drop && npm run test:ai && npm run test:contract",
    "check": "npm run build && npm test && npm run test:legacy && npm run ui:build && npm run test:http:production",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:http:production": "node scripts/test-http.mjs"
  },
  "keywords": [
    "swarm",
    "bzz",
    "confidential-computing",
    "tee",
    "rag",
    "ephemeral-data"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@ethersphere/bee-js": "^13.1.0",
    "dotenv": "^18.0.7",
    "ethers": "^6.17.0",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "hardhat": "^3.19.0",
    "prettier": "^3.9.10",
    "solc": "^0.8.36",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "tmp": "^0.2.7"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
