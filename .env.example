# The current frontend needs no custom environment variables or wallet key.
# These settings belong to the isolated research tools, not live confidential training.

# Local mock Bee. Automatic ingestion intentionally rejects live Bee nodes.
# Research scripts read the process environment; export this variable in your shell
# if changing the default. Only the deployment script loads the root .env itself.
BEE_URL=http://localhost:1633

# Optional mock server port. Keep BEE_URL consistent when changing it.
# PORT=1633

# Optional Sepolia SIMULATION contract deployment only. Never put PRIVATE_KEY in
# a NEXT_PUBLIC_* variable or the frontend. These do not activate Chainlink or a TEE.
SEPOLIA_RPC_URL=https://rpc.sepolia.org
PRIVATE_KEY=your_private_key_here
# Required explicitly for a simulation-only Sepolia deployment. Not a Chainlink router.
SIMULATION_ORACLE_ADDRESS=

# Optional HTTP test target; restricted to loopback by the tests.
# TEST_BASE_URL=http://127.0.0.1:3000
# Next.js sets NODE_ENV from dev/build/start; do not set it here.
