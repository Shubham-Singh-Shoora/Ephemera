# Bee Node Configuration
# For local mock testing, leave as default:
BEE_URL=http://localhost:1633

# For connecting to a live Bee node or Gateway:
# BEE_URL=http://localhost:1633
# BEE_URL=https://gateway.ethswarm.org

# Sepolia / Gnosis RPC (for Phase 3 Smart Contracts & Chainlink)
SEPOLIA_RPC_URL=https://rpc.sepolia.org
PRIVATE_KEY=your_private_key_here
# Required explicitly for a simulation-only Sepolia deployment. Not a Chainlink router.
SIMULATION_ORACLE_ADDRESS=
